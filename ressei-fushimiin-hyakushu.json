 "poems": [
  {
   "seq": "1",
   "text": "のどかなる心にやがて知られけり今日たちかはる春のしるしは",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "匂ひ出づる霞のうちの朝づく日のどけきいろは春ぞこもれる",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ながめやる夕日の山のうす霞かすみにすけるまつのむらだち",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "夕づく日のどかにかすむ山もとの竹のあなたにうぐひすの聲",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "もえそむる野邊の若菜の雪まぜにつむ手もさむくこほる袖哉",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "山の端のかすみもしろくふる雪に春とはいはじさゆるあらしも",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春もまだひとへの梅のしろたへに雪の下なるいろぞまがへる",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "くれなゐの色ことに咲く梅の花しづやの軒にあまりなるまで",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "花はまだ柳のいとのあさみどりくる人あれなこのごろのはる",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "降りけりな音にはたてぬ春雨の見れば草葉のうへぞぬれゆく",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山うすき霞のすゑのゆふづく日かたぶく峯をこゆるかりがね",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山かぜにかすみも雲もはらはれてみがける月は春としもなし",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "またれつる花こそ旣に近からしこずゑの色のにほひそめぬる",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "おほ空の霞もいろにうつりけりよそまであまる花のかをりを",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "雲とのみよそより見つる色もみな花にわけなるはるの山ぶみ",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "櫻花あだにちるとてうらみじよ憂世のうちばかからでもまた",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "山嵐のあらく過ぎつるひととほり花のふぶきに空閉ぢぬなり",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "花にそめし心をやがてうつすとはいはでも深し山吹のいろ",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "うち霞み春ものふかきあけぼのの木だかき岸に咲けるふぢ波",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "春もはやあはれいく夜ぞありあけの月影細きよこ雲のそら",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夏ごろもたちかへしても忘れぬはわかれし春の花ぞめのそで",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "しのびねはふけてや聞くと時鳥いもねぬ夜半をかさねてぞ待つ",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "月はいま木の間はつかに見えそめて山ほととぎす一聲ぞ啼く",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "村雨は曇りもはてぬひとそそぎ晴れゆくそらに啼くほととぎす",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "虹の立つふもとの雲に雨過ぎて露もさながらとるさなへかなO",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "月のもる軒端の風のひとふきにねやのおくまで匂ふたちばな",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "五月雨はしばしたえまと見るはどもなは雲深しをちこちの山",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "つれづれとあまるながめのつくづくと暮しかねたる五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "楢の葉の高きこずゑに風を聞きていさごに白き月ぞすずしき",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "かくて見むそをだに秋の花のため草のみどりはよし深くとも",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "月もまだくらき夜がはの水の上に鵜舟のかがり影ぞほのめく",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "水の上にもえても消えぬ螢こそ風にうごかぬひかりなりけれ",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "あらくすぐる梢のかぜのひとかたへよこぎる雨にいな妻の影",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "鷺の飛ぶむかひの岸に瀧おちてすずしさふかきまつのした道○",
   "kana": "",
   "speaker": "",
   "page": 29,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "おほぬさやあさのゆふしでうち靡きみそぎ涼しき賀茂のかは風",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "秋はまだその色とだにわかなくになにぞ心にうかぶあはれは",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あまつ星ゆきあふ夜半はわれさへに心空なるながめをぞする",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "袖の露もいかがくだくる荻の葉にそよやうれへの秋風のとき",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "常よりも心うつろふながめかなまだ夜のままの露のたまはぎ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かげよわみうつるとなしの秋の日にかりがね寒し薄雲のそら",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さ夜深き枕の山のまつかぜにたぐふを鹿のこゑもまぢかし",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "うけてむかふ心よりこそかなしけれ忘れて見ばや秋も夕も",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "見わたせば遙につづく小山田の色こきかたはかりそめにけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "秋かぜはこずゑを拂ふ夕ぐれに雲もかからぬ山の端のつき",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "うれしくも月のあきしも長き夜よさてだにあかぬ眺とおもへば",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "みるままの姿ばかりか月はただこころの底にすみけるものを",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "人はたれか月よりはかのかげも見ずわれて幾夜の秋のふる里",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "秋ふかきありあけの月の影さむし淺茅いろづくはつしもの庭",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "月はまだ影見えそめぬ草むらの露にみだるるむしのこゑごゑ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ややにほふ朝日の影をみねにこめて霧に消えゆく秋の山の端",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "ころもうつなれもさこそは寒からしあかつき深き霜におきゐて",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "うつるなよ霜はおくとも菊の花つぎて咲くべき色しなければ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "百舌鳥の鳴く山のすそ野の夕づく日色みえそむるはじの一本",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "たづねいる山より山のかさなればもみぢも深き色ぞそひける",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "秋もいまつれてやいぬる夕ぐれのあらしに早き雲のひとむら",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "かきくらし軒端の空はしぐるれどあらしの末に雲ぞはれゆく",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "山風にふるや木の葉のひと曇見ずばしぐれにききまがへまし",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "わけてゆくあともすくなき道の邊の小笹が上に氷るあさしも",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "枯れはつる色こそかはれなほ秋の面影のこるをばなかるかや",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "山河やあきの名殘をなほとめてこほりにすける底のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "霜か雪かはだれに見ゆる庭の上にこほれる月のかげの寒けさ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "浦風に雪ふきまぜてなにはがたあれたる浪に千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "冴えわぶるねざめの床の深き夜に聞くもさびしきをしの一聲",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "竹の葉に嵐もさやぐゆふぐれの雲のゆくへにあられちるなり",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "夜すがらのあらしのままの跡なれやむらむらうすき今朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "ふりつもる雪の木の間の朝づく日花にかをりしはるのおも影",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "降りはてて雲はむらむら氷る夜の月にみがける雪のとほやま",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "みかりするかた野の原のおち草はかくるる程につもる白ゆき",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "すみがまの煙は下になびきつつ雪吹きかくる小野のやまかぜ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "暮れてゆく年はわが身にそふものを思へばはての哀なるかな",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "吹く風のつてにもいかで知らせましかかる思のありとばかりも",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "さてもその晴間やいつぞあま雲のみだれたちぬる戀もうらみも",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "ひと知れぬ心ひとつのおもひより胸にけぶりのたたぬまもなし",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "もらすなよ涙の露はしげくともひとをしのだの杜のことの葉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "こえてこそなほまどはるれ逢坂の關のあなたを何なげきけむ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "今よりのとだえよましてうぢ橋の長き契もたのむとやおもふ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "あま人の玉もかりほす袖の浦にわれたちぬれぬ波のよるよる",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "きぬぎぬになきぬらしつるころも手に露わけそふる道の篠原",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "祈りこししるしやなにぞ日にそへてつらさのみこそ三輪の神杉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "にほどりの下のかよひぢたえざらば浪の浮巢はうかれたりとも",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "ひとりのみ臥猪のかるもかきつくしおもふ思に明けがたき床",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "賴めねば待つともなしの夕ぐれにすがくやいかにささがにの絲",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "むかはましあはれならまします鏡見なれし人のかげのとまらば",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "たのめつるくれをまつまの床の上にぬれて殘れるつげのを枕",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "まちたへてはらはぬ床のすが筵なみだのしたによし朽ちもせよ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "流れ出づる淚にそまるくれなゐのやしほの衣あさしとはみじ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "下紐のとけてもとけぬ心こそありしよりなほ結ぼほれけれ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "忘れじの契もいまやしらま弓わがひくかたにたのむばかりか",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "わがかたは思はぬ波にとまりすなあしまの小舟さぞ障るらむ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "夕ぐれはさてもと思ふあはれより涙に匂ふいりあひのかね",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "やまもとの鷄の初音もほのぼのとまだ雲ふかきあかつきの空",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "かかげてもほのほ短き灯のまどにしたたぬあめのよすがら",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "波白きうらわのまつの葉ごしよりかくれあらはれ見ゆる釣舟",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "うきふしもよしや世の中いく程となぐさめて見る庭のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "鳥かへるふもとの林日はくれて軒端のやまにやどるしらくも",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "秋はつる田づらの庵はかたへよりひた引きすててもる人もなし",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "大方もいづくかかりの宿ならぬ旅とてなにかさのみかなしき",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "入りかかる日影は山のはつかにて里のつづきにけぶり立つ見ゆ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "なほすべてくるしいとはしいくほどの命まつまのよとは思へど",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "君が代は千年のまつのいくたびを植ゑてもつきじ百敷のには",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
